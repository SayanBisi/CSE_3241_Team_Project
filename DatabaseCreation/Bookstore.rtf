\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0
\cf2 \cb10 CREATE VIEW Customer_Reviews AS\
SELECT Customer.FirstName, Customer.LastName, Customer.Email, 
\f1\i \cb10 COUNT
\f0\i0 \cb10 (Reviews.Review_No)as Review_Count, 
\f1\i \cb10 AVG
\f0\i0 \cb10 (Reviews.Rating)as Avg_Rating\
FROM Customer\
JOIN Reviews ON Customer.CustomerID = Reviews.CustomerID\
GROUP BY Customer.CustomerID;\cb3 \
