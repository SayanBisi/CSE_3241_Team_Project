\cf6 \cb3 \
-- Table for Administrators\
CREATE TABLE Admin (\
    AdminID INT NOT NULL,\
    FirstName VARCHAR(15) NOT NULL,\
    LastName VARCHAR(15)  NOT NULL,\
    Email VARCHAR(15),\
    PRIMARY KEY (AdminId)\
);\
\
-- Table for Publishers\
CREATE TABLE Publishers (\
    PublisherID INT  NOT NULL,\
    PName VARCHAR(32) NOT NULL,\
    PRIMARY KEY(PublisherID)\
);\
\
-- Table for Authors\
CREATE TABLE Books_Author (\
    BookID INT NOT NULL,\
    AuthorName VARCHAR(32) NOT NULL,\
    PRIMARY KEY (BookID, AuthorName)\
);\
\
-- Table for Books\
CREATE TABLE Book (\
    BookID INT NOT NULL,\
    PublisherID INT NOT NULL,\
    InventoryID INT NOT NULL,\
    Title VARCHAR(300) NOT NULL,\
    Year INT,\
    Genre VARCHAR(15),\
    ISBN VARCHAR(20) UNIQUE NOT NULL,\
    Price REAL NOT NULL,\
    PRIMARY KEY (BookID),\
    FOREIGN KEY (PublisherID) REFERENCES Publishers(PublisherID),\
    FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID)\
);\
\
-- Table for Inventory\
CREATE TABLE Inventory (\
    InventoryID INT NOT NULL,\
    Quantity INT,\
    PRIMARY KEY (InventoryID)\
);\
\
-- Table for Customers\
CREATE TABLE Customer (\
    CustomerID INT NOT NULL,\
    FirstName VARCHAR(15) NOT NULL,\
    LastName VARCHAR(15) NOT NULL,\
    Email VARCHAR(320) NOT NULL,\
    Phone_Number CHAR(9),\
    PRIMARY KEY (CustomerID)\
);\
\
-- Table for Shopping Cart\
CREATE TABLE Shopping_Cart (\
    Order_No INT NOT NULL,\
    BookID INT NOT NULL,\
    Order_Date DATE NOT NULL,\
    Quantity INT NOT NULL,\
    Cost REAL NOT NULL,\
    FOREIGN KEY (BookID) REFERENCES BOOK(BookID),\
    PRIMARY KEY (Order_No, BookID)\
);\
\
-- Table for Reviews\
CREATE TABLE Reviews (\
    Review_No INT NOT NULL,\
    CustomerID INT NOT NULL,\
    Rating INT,\
    Feedback VARCHAR(750),\
    Date DATE NOT NULL,\
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),\
    PRIMARY KEY(Review_No, CustomerID)\
);\
\
-- Table for Inventory Orders\
CREATE TABLE Inventory_Order (\
    Order_No INT NOT NULL,\
    InventoryID INT NOT NULL,\
    Order_Date DATE NOT NULL,\
    Quantity INT NOT NULL,\
    Cost REAL NOT NULL,\
    FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID),\
    PRIMARY KEY (Order_No, InventoryID)\
);\
\
-- Table for Supplies\
CREATE TABLE Supplies (\
    Order_No INT NOT NULL,\
    PublisherID INT NOT NULL,\
    FOREIGN KEY (Order_No) REFERENCES Inventory_Order(Order_No),\
    FOREIGN KEY (PublisherID) REFERENCES Publishers(PublisherID),\
    PRIMARY KEY (Order_No, PublisherID)\
);\
\
-- Table for Admin Orders\
CREATE TABLE Admin_Orders(\
    Order_No INT NOT NULL,\
    AdminID INT NOT NULL,\
    PRIMARY KEY(Order_No),\
    FOREIGN KEY (Order_No) REFERENCES Inventory_Order(Order_No) ON DELETE CASCADE,\
    FOREIGN KEY (AdminID) REFERENCES Admin(AdminID)\
);\
\
-- Table for Customer Orders\
CREATE TABLE Customer_Orders(\
    Order_No INT NOT NULL,\
    CustomerID INT NOT NULL,\
    PRIMARY KEY(Order_No),\
    FOREIGN KEY (Order_No) REFERENCES Shopping_Cart(Order_No) ON DELETE CASCADE,\
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)\
);\
\
