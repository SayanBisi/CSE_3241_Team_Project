-- Customer_Orders_Total - This view records the total amount spent by each customer in the bookstore. \
-- Provides information about frequent customers to the bookstore\
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0
\cf2 \cb7 CREATE VIEW Customer_Orders_Total AS\
SELECT Customer.CustomerID, Customer.FirstName, Customer.LastName, Customer.Email, 
\f1\i \cb7 COUNT
\f0\i0 \cb7 (Shopping_Cart.Order_No) AS Total_Orders , 
\f1\i \cb7 SUM
\f0\i0 \cb7 (Shopping_Cart.Cost) AS TotalSpent\
FROM Customer_Orders\
JOIN Shopping_Cart ON Customer_Orders.Order_No = Shopping_Cart.Order_No\
JOIN Customer ON Customer.CustomerID = Customer_Orders.CustomerID\
GROUP BY Customer_Orders.CustomerID;\cf8 \cb9 \
